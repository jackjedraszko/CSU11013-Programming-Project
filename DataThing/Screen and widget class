Screen screen1, screen2, currentScreen;

void setup() 
{
    size(500, 400);
    
    screen1 = new Screen(color(255));          // white background
    screen1.addWidget(new Widget(50, 150, 160, 50, "Button 1", color(255, 0, 0)));
    screen1.addWidget(new Widget(50, 240, 160, 50, "Forward",  color(0, 200, 0)));
    
    screen2 = new Screen(color(180));          // grey background
    screen2.addWidget(new Widget(200, 150, 160, 50, "Button 2",  color(0, 0, 255)));
    screen2.addWidget(new Widget(200, 240, 160, 50, "Backward", color(0, 210, 210)));
    
    currentScreen = screen1;
}

void draw() 
{
    currentScreen.draw();
}

void mousePressed() 
{
    Widget pressed = currentScreen.getEvent(mouseX, mouseY);
    
    if (pressed != null)
    {
        if (pressed.label.equals("Forward"))
        {
            currentScreen = screen2;
        }
        else if (pressed.label.equals("Backward"))
        {
            currentScreen = screen1;
        }
        else
        {
            println("Button pressed: " + pressed.label);
        }
    }
}

void mouseMoved()
{
    currentScreen.moved(mouseX, mouseY);
}




// ==== Screen Class ====
class Screen
{
    ArrayList<Widget> widgets;
    color bgColor;
    
    Screen(color bgColor)
    {
        this.widgets = new ArrayList<Widget>();
        this.bgColor = bgColor;
    }
    
    void addWidget(Widget w)
    {
        widgets.add(w);
    }
    
    Widget getEvent(int mx, int my)
    {
        for (Widget w : widgets)
        {
            if (w.clicked(mx, my))
            {
                return w;
            }
        }
        return null;
    }
    
    void moved(int mx, int my)
    {
        for (Widget w : widgets)
        {
            w.moved(mx, my);
        }
    }
    
    void draw()
    {
        background(bgColor);
        for (Widget w : widgets)
        {
            w.draw();
        }
    }
}


// ==== Widget Class ====
class Widget 
{
    int x, y, w, h;
    String label;
    color btnColor;
    boolean hovered;      

    Widget(int x, int y, int w, int h, String label, color btnColor) 
    {
        this.x = x;
        this.y = y;
        this.w = w;
        this.h = h;
        this.label = label;
        this.btnColor = btnColor;
        this.hovered = false;
    }

    void draw() 
    {
        if (hovered) 
        {
            stroke(255);
            strokeWeight(5);
        } 
        else
        {
            stroke(0);
            strokeWeight(5);
        }
      
        fill(btnColor);
        rect(x, y, w, h);
        
        fill(0);
        textAlign(CENTER, CENTER);
        textSize(16);
        text(label, x + w/2, y + h/2);
    }

    boolean clicked(int mx, int my) 
    {
        return mx > x && 
               mx < x + w &&
               my > y &&
               my < y + h;
    }
    
    boolean moved(int mx, int my) 
    {
        hovered = mx > x && 
                  mx < x + w &&
                  my > y &&
                  my < y + h;
        return hovered;
    }
}
